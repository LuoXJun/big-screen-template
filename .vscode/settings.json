{
    // CSS Variable Autocomplete 补全语言：
    // 该扩展按「宿主文档语言 ID」注册补全（selector 为 {scheme: file, language: <id>}），
    // .vue 文件的语言 ID 是 vue，必须列出 vue，<style lang="scss"> 块内的变量补全才会生效；
    // 若只留 scss/css 等，.vue 文件（含样式块）将完全收不到补全。
    "cssVariables.languages": ["vue", "scss", "postcss", "less", "css"],
    // CSS 变量跳转(CSS Variable Autocomplete 扩展)的扫描范围:仅源码;
    // 排除 dist 构建产物——否则 ctrl+click 会命中压缩产物里的同名定义
    "cssVariables.lookupFiles": ["src/**/*.scss", "src/**/*.vue", "src/**/*.css"]
}
