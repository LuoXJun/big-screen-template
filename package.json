{
    "name": "base-screen-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint ./src",
        "formatSrc": "prettier --write src/",
        "format": "prettier --write .",
        "analyze": "vue-mess-detector analyze ./src"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "cesium": "~1.131.0",
        "echarts": "^6.1.0",
        "normalize.css": "^8.0.1",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.66.0",
        "unplugin-auto-import": "^21.1.0",
        "vite": "^8.2.0",
        "vite-plugin-cesium": "^1.2.23",
        "vue-mess-detector": "^0.68.1",
        "vue-tsc": "^3.3.8"
    }
}